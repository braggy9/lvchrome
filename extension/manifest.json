{
  "manifest_version": 3,
  "name": "lvchrome — core work tabs",
  "version": "0.1.0",
  "description": "Return to four core work tabs without reloading them, and route links opened from them to a separate work window.",
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Core work tabs", "default_popup": "popup.html" },
  "options_page": "options.html",
  "commands": {
    "focus-gmail": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Go to Gmail"
    },
    "focus-calendar": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Go to Calendar"
    },
    "focus-matters": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Go to Matters Sheet"
    },
    "focus-mission": {
      "suggested_key": { "default": "Alt+Shift+4" },
      "description": "Go to Mission Control Doc"
    }
  }
}
